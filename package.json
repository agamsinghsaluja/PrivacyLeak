{
  "name": "privacyleak",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable source-code checks with custom rules and AST analysis.",
  "author": "Agam Singh Saluja",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "scan": "tsx packages/scanner/src/cli.ts",
    "demo": "npm run scan -- samples/example.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.8",
    "@babel/types": "7.29.8"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.28.0",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
